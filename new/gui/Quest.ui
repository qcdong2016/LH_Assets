<game_window
    width="380"
    height="460"
    gap="6"
>

    <slot id="title">
        <text id="tt">任 务</text>
    </slot>

    <text color="#ff0" width="100%" text-align="center" id="name" margin="10"></text>
    <div flex-direction="row" class="box">
        <text
            height="100%" id="lv"></text>
    </div>

    <div flex-grow="1" class="box">
        <text width="100%" id="desc"></text>
    </div>

    <div class="box">
        <text color="#E6BE67" id="p1"></text>
        <text color="#E6BE67" id="p2"></text>
        <text color="#E6BE67" id="p3"></text>
        <text color="#E6BE67" id="p4"></text>
        <text color="#E6BE67" id="p5"></text>
    </div>

    <div flex-direction="row-reverse" gap="5" margin="5">
        <green_button width="60" id="gbtn">确认</green_button>
        <red_button width="60" id="rbtn">放弃</red_button>
    </div>

</game_window>