<root>
    <font
        name="default"
        type="sdlttf"
        iter="war3"
        file="C:/Windows/Fonts/simsun.ttc"
        size="14"
    ></font>


    <style name="red_button">
        <normal
            color="#fff"
            background="stretch game.png 74 3 69 25 7 7 7 7"
        />
        <hover
            color="#dfd"
            background="stretch game.png 74 53 69 25 7 7 7 7"
        />
        <pressed
            color="#afa"
            background="stretch game.png 74 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 74 78 69 25 7 7 7 7"
        />
    </style>

    <style name="blue_button">
        <normal
            color="#fff"
            background="stretch game.png 218 3 69 25 7 7 7 7"
        />
        <hover
            color="#dfd"
            background="stretch game.png 218 53 69 25 7 7 7 7"
        />
        <pressed
            color="#afa"
            background="stretch game.png 218 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 218 78 69 25 7 7 7 7"
        />
    </style>

    <style name="yellow_button">
        <normal
            color="#fff"
            background="stretch game.png 3 3 69 25 7 7 7 7"
        />
        <hover
            color="#dfd"
            background="stretch game.png 3 53 69 25 7 7 7 7"
        />
        <pressed
            color="#afa"
            background="stretch game.png 3 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 3 78 69 25 7 7 7 7"
        />
    </style>

    <style name="green_button">
        <normal
            color="#fff"
            background="stretch game.png 146 3 69 25 7 7 7 7"
        />
        <hover
            color="#dfd"
            background="stretch game.png 146 53 69 25 7 7 7 7"
        />
        <pressed
            color="#afa"
            background="stretch game.png 146 28 69 25 7 7 7 7"
        />
        <disabled
            color="#666"
            background="stretch game.png 146 78 69 25 7 7 7 7"
        />
    </style>

    <style name="checkbox">
        <normal background="image game.png 189 181 26 22" />
        <hover background="image game.png 189 203 26 22" />
        <pressed background="image game.png 189 203 26 22" />
        <disabled background="image game.png 189 181 26 22" />

        <checked_normal background="image game.png 189 137 26 22" />
        <checked_hover background="image game.png 189 159 26 22" />
        <checked_pressed background="image game.png 189 159 26 22" />
        <checked_disabled background="image game.png 189 159 26 22" />
    </style>

    <style name="input">
        <normal background="stretch game.png 160 111 24 24 6 6 6 6" />
        <hover background="stretch game.png 160 136 24 24 6 6 6 6" />
        <pressed background="stretch game.png 160 161 24 24 6 6 6 6" />
        <disabled background="stretch game.png 160 111 24 24 6 6 6 6" />
    </style>

    <style name="box">
        <normal
            background="stretch game.png 160 111 24 24 6 6 6 6"
            padding="6"
        ></normal>
    </style>

    <style name="panel">
        <normal
            background="stretch game.png 324 126 46 34 10 10 10 10"
            padding="10"
        ></normal>
    </style>

    <style name="listitem">
        <normal background="stretch game.png 296 194 20 20 5 5 5 5"></normal>
        <hover background="stretch game.png 296 149 20 20 5 5 5 5"></hover>
        <checked_normal background="stretch game.png 296 127 20 20 5 5 5 5"></checked_normal>
        <checked_hover background="stretch game.png 296 105 20 20 5 5 5 5"></checked_hover>
    </style>

    <template name="listitem">
        <checkbox class="listitem"
            padding="2"></checkbox>
    </template>


    <template name="game_input">
        <input
            class="input"
            justify-content="center"
            padding="6"
            min-height="24"
            min-width="24"
        >
            <text id="text"></text>
        </input>
    </template>

    <style name="sliderButton">
        <normal background="image game.png 252 186 11 26" />
        <hover background="image game.png 239 186 11 26" />
        <pressed background="image game.png 239 186 11 26" />
    </style>

    <template name="slider_game">
        <slider
            align-items="center"
            flex-direction="row"
            min-height="26"
        >
            <div width="100%" height="10"
                background="stretch game.png 280 201 12 10 3 3 3 3"
            >
                <div
                    id="progress"
                    width="100%" height="10"
                    background="stretch game.png 266 201 12 10 3 3 3 3"
                ></div>
            </div>
            <div id="slider" class="sliderButton" width="11" height="26" position="absolute"></div>
        </slider>
    </template>

    <template name="game_checkbox">
        <checkbox
            align-items="center"
            flex-direction="row"
        >
            <div id="mark" class="checkbox" width="26" height="22"></div>
            <text id="text"></text>
        </checkbox>
    </template>

    <template name="game_checkbox_right">
        <checkbox
            align-items="center"
            flex-direction="row"
        >
            <text id="text"></text>
            <div id="mark" class="checkbox" width="26" height="22"></div>
        </checkbox>
    </template>

    <template name="blue_button">
        <button
            class="blue_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="red_button">
        <button
            class="red_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="green_button">
        <button
            class="green_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="yellow_button">
        <button
            class="yellow_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="game_window">
        <div
            background="stretch game.png 3 111 148 114 70 55 73 56"
            padding="0 16 16 16"
        >
            <div
                width="100%"
                height="25"
                justify-content="center"
                align-items="center"
            >
                <slot id="title"> </slot>
            </div>
        </div>
    </template>

    <style name="icon_bg">
        <normal background="image game.png 321 93 28 28" width="28" height="28"></normal>
        <hover background="image game.png 349 93 28 28"></hover>
        <pressed background="image game.png 377 93 28 28"></pressed>
        <disabled background="image game.png 405 93 28 28"></disabled>
    </style>
    <template name="icon_list">
        <ItemList
        max-width="168" 
        height="112"
        flex-direction="row"
        flex-wrap="wrap"
        >
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>

            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>

            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>

            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
            <div class="icon_bg"></div>
        </ItemList>
    </template>
</root>