<root>
    <font
        name="default"
        type="sdlttf"
        iter="war3"
        file="C:/Windows/Fonts/simsun.ttc"
        size="14"
    ></font>

     <style name="window">
        <normal
            background="stretch game.png 3 111 148 114 70 55 73 56"
            padding="25 16 16 16"
        />
    </style>

    <style name="red_button">
        <normal
            color="#fff"
            background="stretch game.png 74 3 69 25 7 7 7 7"
        />
        <hover
            color="#f00"
            background="stretch game.png 74 53 69 25 7 7 7 7"
        />
        <pressed
            color="#f0f"
            background="stretch game.png 74 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 74 78 69 25 7 7 7 7"
        />
    </style>

    <style name="blue_button">
        <normal
            color="#fff"
            background="stretch game.png 218 3 69 25 7 7 7 7"
        />
        <hover
            color="#f00"
            background="stretch game.png 218 53 69 25 7 7 7 7"
        />
        <pressed
            color="#f0f"
            background="stretch game.png 218 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 218 78 69 25 7 7 7 7"
        />
    </style>

    <style name="yellow_button">
        <normal
            color="#fff"
            background="stretch game.png 3 3 69 25 7 7 7 7"
        />
        <hover
            color="#f00"
            background="stretch game.png 3 53 69 25 7 7 7 7"
        />
        <pressed
            color="#f0f"
            background="stretch game.png 3 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 3 78 69 25 7 7 7 7"
        />
    </style>

    <style name="green_button">
        <normal
            color="#fff"
            background="stretch game.png 146 3 69 25 7 7 7 7"
        />
        <hover
            color="#f00"
            background="stretch game.png 146 53 69 25 7 7 7 7"
        />
        <pressed
            color="#f0f"
            background="stretch game.png 146 28 69 25 7 7 7 7"
        />
        <disabled
            color="#fff"
            background="stretch game.png 146 78 69 25 7 7 7 7"
        />
    </style>

    <style name="checkbox">
        <normal
            color="#fff"
            background="image game.png 189 181 26 22"
        />
        <hover
            color="#f00"
            background="image game.png 189 203 26 22"
        />
        <pressed
            color="#f0f"
            background="image game.png 189 203 26 22"
        />
        <disabled
            color="#fff"
            background="image game.png 189 181 26 22"
        />

        <checked_normal
            color="#fff"
            background="image game.png 189 137 26 22"
        />
        <checked_hover
            color="#f00"
            background="image game.png 189 159 26 22"
        />
        <checked_pressed
            color="#f0f"
            background="image game.png 189 159 26 22"
        />
        <checked_disabled
            color="#fff"
            background="image game.png 189 159 26 22"
        />
    </style>

    <style name="input">
        <normal
            background="stretch game.png 160 111 24 24 6 6 6 6"
        />
        <hover
            background="stretch game.png 160 136 24 24 6 6 6 6"
        />
        <pressed
            background="stretch game.png 160 161 24 24 6 6 6 6"
        />
        <disabled
            background="stretch game.png 160 111 24 24 6 6 6 6"
        />
    </style>

    <style name="panel">
        <normal
            background="stretch game.png 324 126 46 34 10 10 10 10"
            padding="10"
        ></normal>
    </style>

    <style name="test">
        <normal
            background="#f00"
        ></normal>
    </style>


    <template name="game_input">
        <input
            class="input"
            justify-content="center"
            padding="6"
            min-height="24"
            min-width="24"
        >
            <text id="text"></text>
        </input>
    </template>

    <style name="sliderButton">
        <normal
            color="#fff"
            background="image game.png 252 186 11 26"
        />
        <hover
            color="#f00"
            background="image game.png 239 186 11 26"
        />
        <pressed
            color="#f0f"
            background="image game.png 239 186 11 26"
        />
    </style>

    <template name="slider_game">
        <slider
            align-items="center"
            flex-direction="row"
            min-height="26"
        >
            <div width="100%" height="10"
                background="stretch game.png 280 201 12 10 3 3 3 3"
            >
                <div
                    id="progress"
                    width="100%" height="10"
                    background="stretch game.png 266 201 12 10 3 3 3 3"
                ></div>
            </div>
            <div id="slider" class="sliderButton" width="11" height="26" position="absolute"></div>
        </slider>
    </template>

    <template name="game_checkbox">
        <checkbox
            align-items="center"
            flex-direction="row"
        >
            <div id="mark" class="checkbox" width="26" height="22"></div>
            <text id="text"></text>
        </checkbox>
    </template>

    <template name="game_checkbox_right">
        <checkbox
            align-items="center"
            flex-direction="row"
        >
            <text id="text"></text>
            <div id="mark" class="checkbox" width="26" height="22"></div>
        </checkbox>
    </template>

    <template name="blue_button">
        <button
            class="blue_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="red_button">
        <button
            class="red_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="green_button">
        <button
            class="green_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>

    <template name="yellow_button">
        <button
            class="yellow_button"
            align-items="center"
            justify-content="center"
            padding="5"
        >
            <text id="text"
            ></text>
        </button>
    </template>
</root>