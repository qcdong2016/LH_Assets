<div
    class="window"
    width="280"
    height="410"
    left="270"
    top="100"
    gap="10"
>

    <div
        class="panel"
        width="100%"
        height="190"
        padding="10"
        margin-top="25"
    >
        <text color="#f0f">龙腾</text>
        <text color="#f0f">测试</text>
    </div>

    <div flex-direction="row" gap="10">
        <div>
            <div flex-direction="row">
                <text width="50" text-align="right center">帐号</text>
                <game_input width="100"></game_input>
            </div>

            <div flex-direction="row">
                <text width="50" text-align="right center">密码</text>
                <game_input width="100"></game_input>
            </div>
        </div>
        <green_button width="80">登 陆</green_button>
    </div>

    <game_checkbox_right
        margin-left="71"
    >记住密码</game_checkbox_right>

    <div
        flex-direction="row"
        justify-content="center"
        gap="10"
    >
        <green_button width="80">设置</green_button>
        <red_button width="80">退出</red_button>

    </div>
</div>