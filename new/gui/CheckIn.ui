<game_window
    width="300"
    height="460"
    align-items="center"
    gap="10"
    right="0"
>

    <slot id="title">
        <text id="tt">签 到</text>
    </slot>

    <text margin="20" color="#ff0" id="score"></text>

    <ItemList 
        id="list"
        flex-direction="row"
        flex-grow="1"
        width="240"
        flex-wrap="wrap" justify-content="center">
        <repeat count="8">
            <div class="box" width="60" height="60" > </div>
        </repeat>
    </ItemList>

    <text color="#888">双击上面的物品即可兑换</text>

    <green_button width="100" height="40" margin="20" id="ok">立即签到</green_button>

</game_window>